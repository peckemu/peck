{
  "name": "peck",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "bun --cwd=packages/banner run print && bun run --parallel --filter @peck/emulator --filter @peck/api --filter @peck/website dev",
    "dev:emulator": "bun --cwd=packages/banner run print && bun --cwd=apps/emulator run dev",
    "dev:api": "bun --cwd=packages/banner run print && bun --cwd=apps/api run dev",
    "dev:website": "bun --cwd=apps/website run dev",
    "start": "bun --cwd=packages/banner run print && bun run --parallel --filter @peck/emulator --filter @peck/api start",
    "start:emulator": "bun --cwd=packages/banner run print && bun --cwd=apps/emulator run start",
    "start:api": "bun --cwd=packages/banner run print && bun --cwd=apps/api run start",
    "typecheck": "bun --bun tsc -b",
    "lint": "bun --bun eslint .",
    "lint:fix": "bun --bun eslint . --fix",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "test": "bun test",
    "db:migrate": "bun peck database:migrate",
    "db:rollback": "bun peck database:rollback",
    "db:seed": "bun peck database:seed",
    "peck": "bun --cwd=apps/console run peck"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "10.0.1",
    "@needle-di/core": "1.2.1",
    "@peck/cluster": "workspace:*",
    "@peck/content": "workspace:*",
    "@peck/database": "workspace:*",
    "@peck/game": "workspace:*",
    "@peck/logger": "workspace:*",
    "@peck/packets": "workspace:*",
    "@peck/permissions": "workspace:*",
    "@peck/plugins": "workspace:*",
    "@peck/protocol": "workspace:*",
    "@peck/redis": "workspace:*",
    "@peck/shared": "workspace:*",
    "@types/bun": "1.4.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "jiti": "2.7.0",
    "mitata": "1.0.34",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "uql-orm": "0.104.1"
  }
}
